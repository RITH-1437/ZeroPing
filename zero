#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoload = __DIR__ . '/vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(STDERR, "Dependencies are missing. Run `composer install` in " . __DIR__ . ".\n");
    exit(1);
}

require_once $autoload;
require_once __DIR__ . '/config/config.php';

use App\Core\Application\App;
use App\Core\Console\Console;

App::boot();

try {
    (new Console())->run($argv);
} catch (\Throwable $e) {
    fwrite(STDERR, "\033[31mError: " . $e->getMessage() . "\033[0m\n");
    exit(1);
}
